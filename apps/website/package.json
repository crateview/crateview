{
  "name": "@crateview/website",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Landing page and multilingual documentation for Crateview.",
  "homepage": "https://crateview.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crateview/website.git"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3002",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "node scripts/patch-import-x.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "nuxt": "4.6.4",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint": "^1.15.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.1.0",
    "deepmerge": "file:vendor/deepmerge"
  },
  "version": "0.4.10",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "overrides": {
    "picomatch@2": "file:vendor/crateview-picomatch-hardened-2.3.2.tgz",
    "picomatch@4": "file:vendor/crateview-picomatch-hardened-4.0.7.tgz",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7",
    "deepmerge": "$deepmerge",
    "typescript": "$typescript"
  }
}
